{
  "sects": [
    {
      "id": "sect_shaolin",
      "document": "少林派，位于嵩山少室山，以禅武合一闻名，镇派绝学为易筋经与少林七十二绝技，门人多为出家僧人，讲究慈悲为怀却也护短，与武当并称武林两大泰斗。",
      "metadata": { "name": "少林", "style": "刚正厚重", "rival": "明教" }
    },
    {
      "id": "sect_wudang",
      "document": "武当派，张三丰真人创立于武当山，以柔克刚、以静制动，太极剑与太极拳冠绝天下，门人多为道士，气质出尘，与少林齐名。",
      "metadata": { "name": "武当", "style": "太极绵柔", "rival": "峨眉" }
    },
    {
      "id": "sect_emei",
      "document": "峨眉派，郭襄女侠创立，门下多为女子，剑法凌厉中藏慈悲，绝学有峨眉剑法、飘雪穿云掌，素有侠女之名。",
      "metadata": { "name": "峨眉", "style": "凌厉秀逸", "rival": "昆仑" }
    },
    {
      "id": "sect_gaibang",
      "document": "丐帮，天下第一大帮，弟子遍布市井，以打狗棒法与降龙十八掌威震江湖，帮众重义气、讲辈分，污衣净衣两派时有不合。",
      "metadata": { "name": "丐帮", "style": "刚猛义气", "rival": "_none" }
    },
    {
      "id": "sect_mingjiao",
      "document": "明教，源自波斯，教徒自称明尊座下，行事诡秘却重然诺，镇教神功乾坤大挪移与圣火令武功奇诡，常被正派视为魔教。",
      "metadata": { "name": "明教", "style": "奇诡热烈", "rival": "少林" }
    },
    {
      "id": "sect_tangmen",
      "document": "唐门，蜀中世家，擅长暗器与用毒，孔雀翎、漫天花雨令人闻风丧胆，门规森严，子弟极少踏出巴蜀却足以震慑武林。",
      "metadata": { "name": "唐门", "style": "阴狠暗器", "rival": "华山" }
    },
    {
      "id": "sect_huashan",
      "document": "华山派，位于西岳华山，剑宗气宗之争余波未平，紫霞神功与华山剑法兼备，门人剑出如龙，亦正亦邪。",
      "metadata": { "name": "华山", "style": "剑气双修", "rival": "唐门" }
    },
    {
      "id": "sect_xiaoyao",
      "document": "逍遥派，隐于缥缈峰灵鹫宫，北冥神功吸人内力，凌波微步踏雪无痕，天山六阳掌飘逸绝伦，门人超脱世俗、游戏人间。",
      "metadata": { "name": "逍遥", "style": "飘逸逍遥", "rival": "_none" }
    }
  ],
  "skills": [
    {
      "id": "skill_xl18",
      "document": "降龙十八掌，丐帮镇帮绝学，招式刚猛无俦，飞龙在天、亢龙有悔，掌风所至碎石裂碑，乃外家掌法之极致。",
      "metadata": { "name": "降龙十八掌", "sect": "丐帮", "level": "绝世" }
    },
    {
      "id": "skill_dg9",
      "document": "独孤九剑，剑魔独孤求败所创，破尽天下兵器，总诀式、破剑式、破掌式、破气式，无招胜有招，重在料敌机先。",
      "metadata": { "name": "独孤九剑", "sect": "华山", "level": "绝世" }
    },
    {
      "id": "skill_qkl",
      "document": "乾坤大挪移，明教镇教神功，激发自身潜力、挪移卸化敌劲，七层境界层层递进，练至极处可借力打力、反震强敌。",
      "metadata": { "name": "乾坤大挪移", "sect": "明教", "level": "绝世" }
    },
    {
      "id": "skill_lbwb",
      "document": "凌波微步，逍遥派轻功身法，依周易步位而行，踏雪无痕、飘忽若仙，用以闪避天下诸般攻招，敌虽众无可奈何。",
      "metadata": { "name": "凌波微步", "sect": "逍遥", "level": "上乘" }
    },
    {
      "id": "skill_bmsj",
      "document": "六脉神剑，大理段氏一阳指化气为剑，少商、商阳、中冲、关冲、少冲、少泽六脉齐发，以无形剑气伤人于丈外。",
      "metadata": { "name": "六脉神剑", "sect": "大理段氏", "level": "绝世" }
    },
    {
      "id": "skill_tjq",
      "document": "太极拳剑，武当张三丰晚年所悟，以慢打快、以柔克刚，四两拨千斤，重在引进落空、借力打力，乃内家拳法巅峰。",
      "metadata": { "name": "太极剑", "sect": "武当", "level": "上乘" }
    },
    {
      "id": "skill_yjj",
      "document": "易筋经，少林达摩祖师所传内功宝典，洗髓伐毛、固本培元，练成后内力生生不息，百毒不侵、诸邪难侵。",
      "metadata": { "name": "易筋经", "sect": "少林", "level": "绝世" }
    },
    {
      "id": "skill_kql",
      "document": "孔雀翎，唐门第一暗器，机括既动犹如孔雀开屏， Buzz  Buzz 暗器漫天，中者无幸，乃暗器之王的代名词。",
      "metadata": { "name": "孔雀翎", "sect": "唐门", "level": "绝世" }
    },
    {
      "id": "skill_dbf",
      "document": "打狗棒法，丐帮帮主信物棒法，绊、劈、缠、戳、挑、引、封、转，招招克制群狗亦克群敌，非帮主不传。",
      "metadata": { "name": "打狗棒法", "sect": "丐帮", "level": "上乘" }
    },
    {
      "id": "skill_bmsz",
      "document": "北冥神功，逍遥派吸功大法，纳他人内力为己用，海纳百川有容乃大，施者内力尽失，受者真气暴涨。",
      "metadata": { "name": "北冥神功", "sect": "逍遥", "level": "绝世" }
    }
  ],
  "scenes": [
    {
      "id": "scene_houshan",
      "document": "后山秘境：云雾缭绕的断崖后有古洞遗刻，常有异兽守护前辈毕生武学，少侠误入往往得遇奇缘，亦可能惊动沉睡的机关。",
      "metadata": { "tag": "探险", "tone": "奇遇" }
    },
    {
      "id": "scene_jiulou",
      "document": "江湖酒楼：三教九流汇聚之地，说书人讲着昨日恩仇，醉汉吐露机密，一场切磋或冲突常在酒酣耳热间骤起。",
      "metadata": { "tag": "社交", "tone": "市井" }
    },
    {
      "id": "scene_bishan",
      "document": "比武招亲：擂台高筑，彩球待抛，各方少侠摩拳擦掌，胜者抱得美人归，却也常引来落败者的暗恨与门派纠葛。",
      "metadata": { "tag": "冲突", "tone": "热闹" }
    },
    {
      "id": "scene_miashi",
      "document": "密室机关：古墓或宝藏深处的连环机关，一步错步步险，需以巧劲与机智破解，贪心者多葬身其中。",
      "metadata": { "tag": "解谜", "tone": "惊险" }
    },
    {
      "id": "scene_shanshen",
      "document": "山神庙夜话：荒郊破庙避雨，火堆旁陌生人各怀心思，一句试探可能结为知己，也可能拔刀相向。",
      "metadata": { "tag": "悬疑", "tone": "幽暗" }
    },
    {
      "id": "scene_dahui",
      "document": "武林大会：各派齐聚争夺盟主之位，明争暗斗、合纵连横，一着不慎便成众矢之的，亦可能力挽狂澜名动天下。",
      "metadata": { "tag": "群像", "tone": "宏大" }
    },
    {
      "id": "scene_guigu",
      "document": "古墓奇遇：幽深墓道藏绝世秘籍与机关傀儡，机关兽守门，壁上图形暗含武功心法，取之需以智慧与胆识。",
      "metadata": { "tag": "探险", "tone": "诡谲" }
    },
    {
      "id": "scene_xiangyu",
      "document": "英雄救美：险径之上恶徒欺凌弱女，少侠路见不平拔剑相助，佳人倾心相许，却不知背后牵出更大的恩怨漩涡。",
      "metadata": { "tag": "情感", "tone": "浪漫" }
    },
    {
      "id": "scene_baochou",
      "document": "血仇之夜：仇家寻上门来，烛火摇红刀光映雪，旧怨新恨一并清算，是手刃宿敌还是放下执念，皆在一念。",
      "metadata": { "tag": "冲突", "tone": "惨烈" }
    },
    {
      "id": "scene_wenyi",
      "document": "文斗猜谜：以楹联诗句、机关暗语定高下，文人侠客以智取胜，输者奉茶三杯，胜者赢得满堂喝彩与隐秘线索。",
      "metadata": { "tag": "解谜", "tone": "雅致" }
    }
  ],
  "npcs": [
    {
      "id": "npc_jiuhuang",
      "document": "酒馆老板老周，江湖人称笑面虎，看似和气实则消息灵通，三两句闲谈便能摸清来客底细，最爱听也最爱传各路秘闻。",
      "metadata": { "name": "老周", "sect": "市井", "role": "情报贩子" }
    },
    {
      "id": "npc_zhangmen",
      "document": "少林方丈玄苦大师，德高望重却护短，门人受欺必倾力回护，平日慈悲、动怒时金刚怒目。",
      "metadata": { "name": "玄苦", "sect": "少林", "role": "掌门" }
    },
    {
      "id": "npc_baixiong",
      "document": "后山白猿，通灵灵兽，守护古洞武学遗刻百年，通晓人语却不通人情，唯真正侠义之人可得其指点。",
      "metadata": { "name": "白猿", "sect": "灵兽", "role": "守护者" }
    },
    {
      "id": "npc_tang_nv",
      "document": "唐门少女唐昕，暗器百步穿杨却心肠柔软，奉命追查叛门贼，外表冷艳、内里矛盾，易对因缘而动。",
      "metadata": { "name": "唐昕", "sect": "唐门", "role": "追杀者" }
    },
    {
      "id": "npc_youke",
      "document": "神秘说书人，走南闯北、见多识广，口中故事真假参半，常以一桩旧案引出新的江湖风波。",
      "metadata": { "name": "说书人", "sect": "游方", "role": "引路人" }
    },
    {
      "id": "npc_emnv",
      "document": "峨眉弟子柳如眉，剑出凌厉心藏慈悲，奉师命下山历练，明辨正邪却常被情所扰。",
      "metadata": { "name": "柳如眉", "sect": "峨眉", "role": "侠女" }
    }
  ]
}
